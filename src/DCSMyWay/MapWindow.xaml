<?xml version="1.0" encoding="utf-8" ?>
<Window
  x:Class="DCSMyWay.MapWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="DCSMyWay map">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="DCSMyWay map">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="Assets/AppIcon.ico" />
      </TitleBar.IconSource>
    </TitleBar>

    <WebView2
      x:Name="MapView"
      Grid.Row="1"
      AutomationProperties.AutomationId="MapView" />

    <InfoBar
      x:Name="ErrorBar"
      Grid.Row="1"
      Margin="12"
      VerticalAlignment="Top"
      IsClosable="False"
      Severity="Error"
      Title="The map is not available" />
  </Grid>
</Window>

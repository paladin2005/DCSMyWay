<?xml version="1.0" encoding="utf-8" ?>
<Page
  x:Class="DCSMyWay.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:DCSMyWay"
  xmlns:models="using:DCSMyWay.Models">

  <Grid Padding="12,4,12,12" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
        x:Name="DcsStatusText"
        VerticalAlignment="Center"
        AutomationProperties.AutomationId="DcsStatus"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Style="{StaticResource CaptionTextBlockStyle}"
        TextWrapping="Wrap" />

      <StackPanel
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="6">
        <Border
          x:Name="AircraftChip"
          Style="{StaticResource AccentChipStyle}"
          Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon
              FontSize="12"
              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
              Glyph="&#xE709;" />
            <TextBlock
              x:Name="AircraftText"
              AutomationProperties.AutomationId="AircraftText"
              FontWeight="SemiBold"
              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}" />
          </StackPanel>
        </Border>
        <Border
          x:Name="SteerpointChip"
          Style="{StaticResource ChipStyle}"
          Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon FontSize="12" Glyph="&#xE81D;" />
            <TextBlock
              x:Name="SteerpointText"
              AutomationProperties.AutomationId="SteerpointText"
              FontWeight="SemiBold"
              Style="{StaticResource CaptionTextBlockStyle}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <ToggleButton
        x:Name="CrosshairButton"
        Grid.Column="1"
        AutomationProperties.AutomationId="CrosshairButton"
        Click="CrosshairButton_Click"
        Content="Crosshair"
        IsEnabled="False" />
    </Grid>

    <TextBlock
      Grid.Row="1"
      Style="{StaticResource BodyStrongTextBlockStyle}"
      Text="Waypoints" />

    <ListView
      x:Name="WaypointList"
      Grid.Row="2"
      Padding="0,4"
      AutomationProperties.AutomationId="WaypointList"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="{StaticResource OverlayCornerRadius}"
      SelectionMode="None">
      <ListView.Resources>
        <ResourceDictionary>
          <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
              <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
              <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
              <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
              <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorTertiaryBrush" />
              <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
              <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
              <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SystemFillColorCriticalBrush" />
              <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
              <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="SystemFillColorCriticalBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
              <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
              <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
              <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
              <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorTertiaryBrush" />
              <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
              <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
              <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SystemFillColorCriticalBrush" />
              <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
              <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="SystemFillColorCriticalBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            </ResourceDictionary>
          </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
      </ListView.Resources>
      <ListView.ItemContainerTransitions>
        <TransitionCollection />
      </ListView.ItemContainerTransitions>
      <ListView.ItemContainerStyle>
        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
          <Setter Property="MinHeight" Value="40" />
          <Setter Property="Padding" Value="8,2,4,2" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="models:WaypointItem">
          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
              AutomationProperties.Name="Transferred"
              FontSize="12"
              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
              Glyph="&#xE73E;"
              Visibility="{x:Bind IsTransferred, Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap">
                <Run Text="{x:Bind Waypoint.Name, Mode=OneWay}" />
                <Run Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind local:MainPage.ThreatLabel(Waypoint), Mode=OneWay}" />
              </TextBlock>
              <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind local:MainPage.Describe(Waypoint.Latitude, Waypoint.Longitude, Waypoint.ElevationMeters)}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            </StackPanel>
            <ToggleButton
              Grid.Column="2"
              Padding="6,4"
              AutomationProperties.Name="Attack phase target"
              Click="TargetToggle_Click"
              IsChecked="{x:Bind Waypoint.IsTarget, Mode=OneWay}"
              ToolTipService.ToolTip="Attack phase target"
              Visibility="{x:Bind ShowsTargetToggle, Mode=OneWay}">
              <PathIcon Data="M6,1.5 A4.5,4.5 0 1 1 6,10.5 A4.5,4.5 0 1 1 6,1.5 Z M6,2.6 A3.4,3.4 0 1 1 6,9.4 A3.4,3.4 0 1 1 6,2.6 Z M5.45,0 L6.55,0 L6.55,1.5 L5.45,1.5 Z M5.45,2.6 L6.55,2.6 L6.55,4.4 L5.45,4.4 Z M5.45,7.6 L6.55,7.6 L6.55,9.4 L5.45,9.4 Z M5.45,10.5 L6.55,10.5 L6.55,12 L5.45,12 Z M0,5.45 L1.5,5.45 L1.5,6.55 L0,6.55 Z M2.6,5.45 L4.4,5.45 L4.4,6.55 L2.6,6.55 Z M7.6,5.45 L9.4,5.45 L9.4,6.55 L7.6,6.55 Z M10.5,5.45 L12,5.45 L12,6.55 L10.5,6.55 Z" />
            </ToggleButton>
            <Button
              Grid.Column="3"
              Padding="6,4"
              AutomationProperties.Name="Edit"
              Click="EditWaypointButton_Click"
              Style="{StaticResource SubtleButtonStyle}"
              ToolTipService.ToolTip="Edit">
              <FontIcon FontSize="12" Glyph="&#xE70F;" />
            </Button>
            <Button
              Grid.Column="4"
              Padding="6,4"
              AutomationProperties.Name="Delete"
              Click="DeleteWaypointButton_Click"
              Style="{StaticResource SubtleButtonStyle}"
              ToolTipService.ToolTip="Delete">
              <FontIcon FontSize="12" Glyph="&#xE74D;" />
            </Button>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <StackPanel
      Grid.Row="3"
      Orientation="Horizontal"
      Spacing="8">
      <Grid>
        <SplitButton
          x:Name="TransferButton"
          HorizontalAlignment="Stretch"
          AutomationProperties.AutomationId="TransferButton"
          Click="TransferButton_Click"
          Content="Transfer to aircraft"
          IsEnabled="False">
          <SplitButton.Resources>
            <ResourceDictionary>
              <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
              <StaticResource x:Key="SplitButtonBackground" ResourceKey="AccentButtonBackground" />
              <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="AccentButtonBackgroundPointerOver" />
              <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="AccentButtonBackgroundPressed" />
              <StaticResource x:Key="SplitButtonBackgroundDisabled" ResourceKey="AccentButtonBackgroundDisabled" />
              <StaticResource x:Key="SplitButtonForeground" ResourceKey="AccentButtonForeground" />
              <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="AccentButtonForegroundPointerOver" />
              <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="AccentButtonForegroundPressed" />
              <StaticResource x:Key="SplitButtonForegroundDisabled" ResourceKey="AccentButtonForegroundDisabled" />
              <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="AccentButtonBorderBrush" />
              <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="AccentButtonBorderBrushPointerOver" />
              <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="AccentButtonBorderBrushPressed" />
              <StaticResource x:Key="SplitButtonBorderBrushDisabled" ResourceKey="AccentButtonBorderBrushDisabled" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
              <StaticResource x:Key="SplitButtonBackground" ResourceKey="AccentButtonBackground" />
              <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="AccentButtonBackgroundPointerOver" />
              <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="AccentButtonBackgroundPressed" />
              <StaticResource x:Key="SplitButtonBackgroundDisabled" ResourceKey="AccentButtonBackgroundDisabled" />
              <StaticResource x:Key="SplitButtonForeground" ResourceKey="AccentButtonForeground" />
              <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="AccentButtonForegroundPointerOver" />
              <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="AccentButtonForegroundPressed" />
              <StaticResource x:Key="SplitButtonForegroundDisabled" ResourceKey="AccentButtonForegroundDisabled" />
              <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="AccentButtonBorderBrush" />
              <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="AccentButtonBorderBrushPointerOver" />
              <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="AccentButtonBorderBrushPressed" />
              <StaticResource x:Key="SplitButtonBorderBrushDisabled" ResourceKey="AccentButtonBorderBrushDisabled" />
            </ResourceDictionary>
              </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
          </SplitButton.Resources>
          <SplitButton.Flyout>
            <MenuFlyout Opening="TransferMenu_Opening" Placement="TopEdgeAlignedLeft">
              <MenuFlyoutItem
                x:Name="OverwriteFromActiveItem"
                AutomationProperties.AutomationId="OverwriteFromActiveItem"
                Click="OverwriteFromActiveItem_Click">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE70F;" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem
                x:Name="AddAfterActiveItem"
                AutomationProperties.AutomationId="AddAfterActiveItem"
                Click="AddAfterActiveItem_Click">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE710;" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
            </MenuFlyout>
          </SplitButton.Flyout>
        </SplitButton>
        <Button
          x:Name="CancelTransferButton"
          HorizontalAlignment="Stretch"
          AutomationProperties.AccessibilityView="Raw"
          AutomationProperties.AutomationId="CancelTransferButton"
          Click="CancelTransferButton_Click"
          Content="Cancel transfer"
          IsHitTestVisible="False"
          IsTabStop="False"
          Opacity="0" />
      </Grid>
      <Button
        x:Name="ClearButton"
        AutomationProperties.AutomationId="ClearButton"
        Click="ClearButton_Click"
        Content="Clear"
        IsEnabled="False" />
    </StackPanel>

    <InfoBar
      x:Name="MessageBar"
      Grid.Row="4"
      AutomationProperties.AutomationId="MessageBar"
      IsClosable="True" />

    <ContentDialog
      x:Name="RepeatTransferDialog"
      Title="Transfer all again?"
      CloseButtonText="Cancel"
      DefaultButton="Close"
      PrimaryButtonText="Transfer again">
      <TextBlock x:Name="RepeatTransferText" TextWrapping="Wrap" />
    </ContentDialog>

    <ContentDialog
      x:Name="EditDialog"
      Title="Edit waypoint"
      CloseButtonText="Cancel"
      DefaultButton="Primary"
      Opened="EditDialog_Opened"
      PrimaryButtonText="Save">
      <StackPanel Spacing="12">
        <TextBox
          x:Name="NameBox"
          AutomationProperties.AutomationId="NameBox"
          CharacterCasing="Upper"
          Header="Name"
          TextChanged="NameBox_TextChanged" />
        <ComboBox
          x:Name="ThreatBox"
          HorizontalAlignment="Stretch"
          AutomationProperties.AutomationId="ThreatBox"
          DisplayMemberPath="Name"
          Header="Target type" />
      </StackPanel>
    </ContentDialog>
  </Grid>
</Page>

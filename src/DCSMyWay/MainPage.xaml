<?xml version="1.0" encoding="utf-8" ?>
<Page
  x:Class="DCSMyWay.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:DCSMyWay"
  xmlns:models="using:DCSMyWay.Models">

  <Grid Padding="12,4,12,12" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
        x:Name="DcsStatusText"
        VerticalAlignment="Center"
        AutomationProperties.AutomationId="DcsStatus"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Style="{StaticResource CaptionTextBlockStyle}"
        TextWrapping="Wrap" />

      <StackPanel
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="6">
        <Border
          x:Name="AircraftChip"
          Style="{StaticResource AccentChipStyle}"
          Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon
              FontSize="12"
              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
              Glyph="&#xE709;" />
            <TextBlock
              x:Name="AircraftText"
              AutomationProperties.AutomationId="AircraftText"
              FontWeight="SemiBold"
              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}" />
          </StackPanel>
        </Border>
        <Border
          x:Name="SteerpointChip"
          Style="{StaticResource ChipStyle}"
          Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon FontSize="12" Glyph="&#xE81D;" />
            <TextBlock
              x:Name="SteerpointText"
              AutomationProperties.AutomationId="SteerpointText"
              FontWeight="SemiBold"
              Style="{StaticResource CaptionTextBlockStyle}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <ToggleButton
        x:Name="CrosshairButton"
        Grid.Column="1"
        AutomationProperties.AutomationId="CrosshairButton"
        Click="CrosshairButton_Click"
        Content="Crosshair"
        IsEnabled="False" />
    </Grid>

    <TextBlock
      Grid.Row="1"
      Style="{StaticResource BodyStrongTextBlockStyle}"
      Text="Waypoints" />

    <ListView
      x:Name="WaypointList"
      Grid.Row="2"
      Padding="0,4"
      AutomationProperties.AutomationId="WaypointList"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="{StaticResource OverlayCornerRadius}"
      SelectionMode="None">
      <ListView.ItemContainerTransitions>
        <TransitionCollection />
      </ListView.ItemContainerTransitions>
      <ListView.ItemContainerStyle>
        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
          <Setter Property="MinHeight" Value="40" />
          <Setter Property="Padding" Value="8,2,4,2" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="models:WaypointItem">
          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
              AutomationProperties.Name="Transferred"
              FontSize="12"
              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
              Glyph="&#xE73E;"
              Visibility="{x:Bind IsTransferred, Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Waypoint.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
              <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind local:MainPage.Describe(Waypoint.Latitude, Waypoint.Longitude, Waypoint.ElevationMeters)}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            </StackPanel>
            <Button
              Grid.Column="2"
              Padding="6,4"
              AutomationProperties.Name="Rename"
              Click="RenameWaypointButton_Click"
              Style="{StaticResource SubtleButtonStyle}"
              ToolTipService.ToolTip="Rename">
              <FontIcon FontSize="12" Glyph="&#xE70F;" />
            </Button>
            <Button
              Grid.Column="3"
              Padding="6,4"
              AutomationProperties.Name="Delete"
              Click="DeleteWaypointButton_Click"
              Style="{StaticResource SubtleButtonStyle}"
              ToolTipService.ToolTip="Delete">
              <FontIcon FontSize="12" Glyph="&#xE74D;" />
            </Button>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <StackPanel
      Grid.Row="3"
      Orientation="Horizontal"
      Spacing="8">
      <Button
        x:Name="TransferButton"
        AutomationProperties.AutomationId="TransferButton"
        AutomationProperties.Name="Transfer to aircraft"
        Click="TransferButton_Click"
        IsEnabled="False"
        Style="{StaticResource AccentButtonStyle}">
        <Grid>
          <TextBlock
            x:Name="TransferText"
            HorizontalAlignment="Center"
            Text="Transfer to aircraft" />
          <TextBlock
            x:Name="CancelTransferText"
            HorizontalAlignment="Center"
            Opacity="0"
            Text="Cancel transfer" />
        </Grid>
      </Button>
      <Button
        x:Name="ClearButton"
        AutomationProperties.AutomationId="ClearButton"
        Click="ClearButton_Click"
        Content="Clear"
        IsEnabled="False" />
    </StackPanel>

    <InfoBar
      x:Name="MessageBar"
      Grid.Row="4"
      AutomationProperties.AutomationId="MessageBar"
      IsClosable="True" />

    <ContentDialog
      x:Name="RepeatTransferDialog"
      Title="Transfer all again?"
      CloseButtonText="Cancel"
      DefaultButton="Close"
      PrimaryButtonText="Transfer again">
      <TextBlock x:Name="RepeatTransferText" TextWrapping="Wrap" />
    </ContentDialog>

    <ContentDialog
      x:Name="RenameDialog"
      Title="Rename waypoint"
      CloseButtonText="Cancel"
      DefaultButton="Primary"
      Opened="RenameDialog_Opened"
      PrimaryButtonText="Rename">
      <TextBox
        x:Name="RenameBox"
        AutomationProperties.AutomationId="RenameBox"
        CharacterCasing="Upper"
        TextChanged="RenameBox_TextChanged" />
    </ContentDialog>
  </Grid>
</Page>

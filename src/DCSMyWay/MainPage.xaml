<?xml version="1.0" encoding="utf-8" ?>
<Page
  x:Class="DCSMyWay.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Padding="16" Spacing="12">
    <ToggleSwitch
      x:Name="AlwaysOnTopSwitch"
      Header="Always on top"
      IsOn="True" />
    <ToggleSwitch
      x:Name="NoActivateSwitch"
      Header="Don't take focus from other apps"
      IsOn="True" />
    <TextBlock
      x:Name="ForegroundText"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      Style="{StaticResource CaptionTextBlockStyle}"
      TextTrimming="CharacterEllipsis" />
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button
        Click="ClickTestButton_Click"
        Content="Click test"
        Style="{StaticResource AccentButtonStyle}" />
      <TextBlock
        x:Name="ClickCountText"
        VerticalAlignment="Center"
        Text="Clicks: 0" />
    </StackPanel>
    <TextBox
      x:Name="TypingTestBox"
      AutomationProperties.Name="Typing test"
      PlaceholderText="Hover, click and type here"
      PointerEntered="TypingTestBox_PointerEntered"
      PointerExited="TypingTestBox_PointerExited" />
    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Global key presses" />
    <TextBlock
      x:Name="KeyLogText"
      AutomationProperties.AutomationId="KeyLog"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      Style="{StaticResource CaptionTextBlockStyle}" />
  </StackPanel>
</Page>

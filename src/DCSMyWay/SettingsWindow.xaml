<?xml version="1.0" encoding="utf-8" ?>
<Window
  x:Class="DCSMyWay.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Settings">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="Settings" />

    <StackPanel
      Grid.Row="1"
      Padding="16"
      Spacing="12">
      <ToggleSwitch x:Name="AlwaysOnTopSwitch" Header="Always on top" />
      <ToggleSwitch x:Name="DontTakeFocusSwitch" Header="Don't take focus from other apps" />
      <RadioButtons
        x:Name="ThemeButtons"
        Header="Theme"
        MaxColumns="3">
        <x:String>System</x:String>
        <x:String>Light</x:String>
        <x:String>Dark</x:String>
      </RadioButtons>
      <Button
        x:Name="RemoveFromDcsButton"
        Click="RemoveFromDcsButton_Click"
        Content="Remove from DCS" />
      <InfoBar
        x:Name="MessageBar"
        IsClosable="True"
        Severity="Error" />
    </StackPanel>

    <ContentDialog
      x:Name="RemoveFromDcsDialog"
      Title="Remove DCSMyWay from DCS?"
      CloseButtonText="Cancel"
      DefaultButton="Close"
      PrimaryButtonText="Remove and close">
      <TextBlock TextWrapping="Wrap" Text="This deletes its scripts from Saved Games and its lines in Export.lua and autoexec.cfg, then closes DCSMyWay. Starting DCSMyWay again installs them back." />
    </ContentDialog>
  </Grid>
</Window>
